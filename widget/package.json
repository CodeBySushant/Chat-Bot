{
  "name": "chatbot-widget",
  "version": "1.0.0",
  "private": true,
  "description": "Embeddable AI chat widget — single script tag, works on any site.",
  "scripts": {
    "build": "esbuild src/widget.ts --bundle --minify --format=iife --target=es2018 --outfile=dist/widget.js --sourcemap",
    "build:dev": "esbuild src/widget.ts --bundle --format=iife --target=es2018 --outfile=dist/widget.dev.js",
    "watch": "esbuild src/widget.ts --bundle --format=iife --target=es2018 --outfile=dist/widget.dev.js --watch"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  }
}
