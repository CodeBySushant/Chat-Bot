ENV=development
LOG_LEVEL=INFO
PROJECT_NAME=Chatbot SaaS API
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://app_rw:app_rw@localhost:5432/chatbot_saas
DATABASE_ADMIN_URL=postgresql+asyncpg://app_admin:app_admin@localhost:5432/chatbot_saas
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
SQL_ECHO=false

JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
RESET_TOKEN_EXPIRE_HOURS=1
VERIFY_TOKEN_EXPIRE_HOURS=48

CORS_ORIGINS=["http://localhost:3000"]

# --- JWT issuer/audience (added in hardening) ---
JWT_ISSUER=chatbot-saas
JWT_AUDIENCE=chatbot-saas-api
JWT_LEEWAY_SECONDS=10

# --- Rate limiting (added in hardening) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_REFRESH_MAX=30
RATE_LIMIT_PASSWORD_RESET_MAX=5

# --- Knowledge base / ingestion (added) ---
STORAGE_DIR=/tmp/kb-storage
MAX_UPLOAD_MB=25
CHUNK_SIZE_CHARS=1000
CHUNK_OVERLAP_CHARS=150
INGEST_WORKERS=2
EMBEDDING_PROVIDER=local-hash
EMBEDDING_MODEL=local-hash-v1
EMBEDDING_DIM=384
# For OpenAI embeddings instead: EMBEDDING_PROVIDER=openai, set OPENAI_API_KEY, EMBEDDING_DIM=1536
QDRANT_PATH=/tmp/qdrant-data
QDRANT_COLLECTION=kb_chunks
# For a Qdrant server instead: QDRANT_URL=http://localhost:6333

# --- Web crawler (added) ---
CRAWL_WORKERS=1
CRAWLER_USER_AGENT=ChatbotSaaSBot/1.0 (+https://example.com/bot)
CRAWLER_MAX_PAGES=50
CRAWLER_MAX_DEPTH=3
CRAWLER_CONCURRENCY=4
CRAWLER_TIMEOUT_SECONDS=15
CRAWLER_RETRY_MAX=3
CRAWLER_RESPECT_ROBOTS=true

# --- Unified AI (LLM) provider (added) ---
AI_PROVIDER=ollama
AI_REQUEST_TIMEOUT=60
AI_DEFAULT_TEMPERATURE=0.2
AI_DEFAULT_MAX_TOKENS=1024
OPENAI_CHAT_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# To use OpenAI: AI_PROVIDER=openai and set OPENAI_API_KEY (OPENAI_BASE_URL defaults to api.openai.com/v1)

# --- RAG (added) ---
RAG_TOP_K=5
RAG_MIN_SCORE=0.0
RAG_MAX_CONTEXT_CHARS=6000
RAG_HISTORY_TURNS=6
