{
  "uid": "workers-queue",
  "title": "Workers & Queue",
  "tags": ["chatbot-saas", "workers"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "type": "timeseries", "title": "Queue depth by status",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [ { "expr": "job_queue_depth", "legendFormat": "{{status}}" } ]
    },
    {
      "type": "stat", "title": "Dead-letter (15m)",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } } },
      "targets": [ { "expr": "increase(jobs_processed_total{outcome=\"dead\"}[15m])" } ]
    },
    {
      "type": "timeseries", "title": "Jobs processed by outcome",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "targets": [ { "expr": "sum(rate(jobs_processed_total[5m])) by (outcome)", "legendFormat": "{{outcome}}" } ]
    },
    {
      "type": "timeseries", "title": "Job duration p95 by task",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [ { "expr": "histogram_quantile(0.95, sum(rate(job_duration_seconds_bucket[5m])) by (le, task))", "legendFormat": "{{task}}" } ]
    },
    {
      "type": "timeseries", "title": "Postgres connections",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [ { "expr": "sum(pg_stat_activity_count)", "legendFormat": "connections" } ]
    }
  ]
}
