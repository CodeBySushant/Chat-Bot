# ---- Copy to .env; never commit the real .env. Secrets go in ./secrets/* files. ----
REGISTRY=ghcr.io/acme
TAG=latest
ENVIRONMENT=production

# Non-secret config (secrets are mounted from ./secrets/* via *_FILE env vars)
API_V1_PREFIX=/api/v1
PROJECT_NAME=Chatbot SaaS API
LOG_LEVEL=INFO
LOG_FORMAT=json
CORS_ORIGINS=https://app.example.com

AI_PROVIDER=openai
OPENAI_CHAT_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=openai

QDRANT_COLLECTION=kb_chunks
JOB_WORKERS=4

METRICS_ENABLED=true
OTEL_ENABLED=true
OTEL_SERVICE_NAME=chatbot-saas-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_TRACES_SAMPLER_RATIO=0.1

BILLING_PROVIDER=stripe
