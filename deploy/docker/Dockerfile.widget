# syntax=docker/dockerfile:1.7
# ---- Widget build container: esbuild -> static bundle served by nginx ----
FROM node:20-alpine AS builder
WORKDIR /widget
COPY package.json package-lock.json* ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build

FROM nginx:1.27-alpine AS runtime
COPY --from=builder /widget/dist/ /usr/share/nginx/html/
COPY widget-nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 8081
HEALTHCHECK --interval=20s --timeout=3s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8081/widget.js >/dev/null || exit 1
